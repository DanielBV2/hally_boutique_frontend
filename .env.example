# URL base de la API REST del backend (Express + Prisma + PostgreSQL).
# Server-only: SOLO se lee en Route Handlers (BFF) y helpers server-side.
# Nunca se expone al navegador.
EXPRESS_API_URL=http://localhost:3000/api

# URL pública del frontend. Pública: se usa en metadata/SEO
# (generación de canonical, og:*, sitemap, etc.).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# DSN de Sentry. Pública, opcional: si no está definida, Sentry queda
# deshabilitado y la app funciona igual (útil para CI).
NEXT_PUBLIC_SENTRY_DSN=